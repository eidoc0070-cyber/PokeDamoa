{
  "name": "my-test-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:data": "bun scripts/build-data.ts",
    "build:sprites": "bun scripts/update-sprites.ts",
    "build:assets": "bun run build:data && bun run build:sprites",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bun test --parallel=1",
    "test:watch": "bun test --parallel=1 --watch",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "security": "bun-osv-scanner",
    "ready": "bun run format && bun run lint:fix && bun run build && bun run test",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@happy-dom/global-registrator": "^20.10.0",
    "@types/bun": "^1.3.14",
    "bun-osv-scanner": "^2.0.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.0",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "vite": "^8.0.16"
  }
}
